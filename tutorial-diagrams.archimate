<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="MFT-DAF-Tutorial" id="id-model-mft-daf" version="5.0.0">
  <folder name="Strategy" id="id-fldr-strtgy" type="strategy"/>
  <folder name="Business" id="id-fldr-biz" type="business">
    <element xsi:type="archimate:BusinessActor" name="Third Party Client" id="id-biz-actor-3p-client"/>
    <element xsi:type="archimate:BusinessObject" name="zip file collection" id="id-biz-obj-zipfile"/>
  </folder>
  <folder name="Application" id="id-fldr-app" type="application">
    <element xsi:type="archimate:ApplicationService" name="MFT SaaS" id="id-app-svc-mft-saas"/>
    <element xsi:type="archimate:ApplicationService" name="Integration SaaS" id="id-app-svc-intg-saas"/>
    <element xsi:type="archimate:DataObject" name="File Uploaded Notification" id="id-app-obj-file-notif"/>
