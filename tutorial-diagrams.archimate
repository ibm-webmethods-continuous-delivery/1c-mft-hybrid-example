          </sourceConnection>
        </child>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-dv-df-private-loc" archimateElement="id-other-loc-private">
        <bounds x="547" y="11" width="192" height="27"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-dv-df-privloc-to-res" source="id-dv-df-private-loc" target="id-dv-df-private-res" archimateRelationship="id-rel-asgn-privloc-res"/>
