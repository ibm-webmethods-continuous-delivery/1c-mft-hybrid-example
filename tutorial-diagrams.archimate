  </folder>
  <folder name="Views" id="id-fldr-views" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" name="Data Flow" id="id-view-default">
      <child xsi:type="archimate:DiagramObject" id="id-dv-df-ibm-saas" targetConnections="id-dv-df-cloudrgn-to-ibm" textAlignment="1" archimateElement="id-other-grp-ibm-saas">
        <bounds x="168" y="54" width="302" height="199"/>
        <child xsi:type="archimate:DiagramObject" id="id-dv-df-mft-saas" targetConnections="id-dv-df-3pclient-to-mft id-dv-df-intg-to-mft" fillColor="#feffff" textPosition="1" archimateElement="id-app-svc-mft-saas">
          <bounds x="13" y="36" width="120" height="55"/>
          <sourceConnection xsi:type="archimate:Connection" id="id-dv-df-mft-to-intg" targetConnections="id-dv-df-notif-to-mftconn" source="id-dv-df-mft-saas" target="id-dv-df-intg-saas" archimateRelationship="id-rel-flow-mft-intg">
            <bendpoint startX="96" startY="21" endX="-108" endY="21"/>
          </sourceConnection>
          <sourceConnection xsi:type="archimate:Connection" id="id-dv-df-mft-to-3pclient" source="id-dv-df-mft-saas" target="id-dv-df-3p-client" archimateRelationship="id-rel-srv-mft-3pclient"/>
          <sourceConnection xsi:type="archimate:Connection" id="id-dv-df-mft-to-edge-fl" targetConnections="id-dv-df-zip-to-edgeconn" source="id-dv-df-mft-saas" target="id-dv-df-edge-proc" archimateRelationship="id-rel-flow-mft-edge">
            <bendpoint startX="12" startY="117" endX="-384" endY="117"/>
            <bendpoint startX="384" startY="117" endX="-12" endY="117"/>
          </sourceConnection>
          <sourceConnection xsi:type="archimate:Connection" id="id-dv-df-mft-to-edge-sv" source="id-dv-df-mft-saas" target="id-dv-df-edge-proc" archimateRelationship="id-rel-srv-mft-edge">
            <bendpoint startX="36" startY="105" endX="-360" endY="105"/>
            <bendpoint startX="360" startY="105" endX="-36" endY="105"/>
          </sourceConnection>
        </child>
        <child xsi:type="archimate:DiagramObject" id="id-dv-df-file-notif" fillColor="#feffff" textPosition="1" archimateElement="id-app-obj-file-notif">
          <bounds x="169" y="108" width="120" height="55"/>
          <sourceConnection xsi:type="archimate:Connection" id="id-dv-df-notif-to-mftconn" source="id-dv-df-file-notif" target="id-dv-df-mft-to-intg" archimateRelationship="id-rel-assoc-notif-flow2"/>
          <sourceConnection xsi:type="archimate:Connection" id="id-dv-df-notif-to-intgconn" source="id-dv-df-file-notif" target="id-dv-df-intg-to-edge" archimateRelationship="id-rel-assoc-notif-flow3"/>
        </child>
        <child xsi:type="archimate:DiagramObject" id="id-dv-df-intg-saas" targetConnections="id-dv-df-mft-to-intg" fillColor="#feffff" textPosition="1" archimateElement="id-app-svc-intg-saas">
          <bounds x="169" y="36" width="120" height="55"/>
          <sourceConnection xsi:type="archimate:Connection" id="id-dv-df-intg-to-edge" targetConnections="id-dv-df-notif-to-intgconn" source="id-dv-df-intg-saas" target="id-dv-df-edge-proc" archimateRelationship="id-rel-flow-intg-edge">
            <bendpoint startX="96" startY="21" endX="-96" endY="21"/>
          </sourceConnection>
          <sourceConnection xsi:type="archimate:Connection" id="id-dv-df-intg-to-mft" source="id-dv-df-intg-saas" target="id-dv-df-mft-saas" archimateRelationship="id-rel-srv-intg-mft"/>
          <sourceConnection xsi:type="archimate:Connection" id="id-dv-df-intg-to-edge-sv" source="id-dv-df-intg-saas" target="id-dv-df-edge-proc" archimateRelationship="id-rel-srv-intg-edge"/>
        </child>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-dv-df-3p-client" targetConnections="id-dv-df-mft-to-3pclient" fillColor="#feffff" textPosition="1" archimateElement="id-biz-actor-3p-client">
        <bounds x="12" y="96" width="120" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-dv-df-3pclient-to-mft" targetConnections="id-dv-df-zip-to-flowconn" source="id-dv-df-3p-client" target="id-dv-df-mft-saas" archimateRelationship="id-rel-flow-3pclient-mft">
          <bendpoint startX="95" startY="21" endX="-96" endY="21"/>
        </sourceConnection>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-dv-df-cloud-rgn" archimateElement="id-other-loc-cloud-rgn">
        <bounds x="192" y="12" width="241" height="25"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-dv-df-cloudrgn-to-ibm" source="id-dv-df-cloud-rgn" target="id-dv-df-ibm-saas" archimateRelationship="id-rel-asgn-cloudrgn-ibm"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-dv-df-zipfile" fillColor="#feffff" textPosition="1" archimateElement="id-biz-obj-zipfile">
        <bounds x="36" y="192" width="120" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-dv-df-zip-to-flowconn" source="id-dv-df-zipfile" target="id-dv-df-3pclient-to-mft" archimateRelationship="id-rel-assoc-zip-flow1"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-dv-df-zip-to-edgeconn" source="id-dv-df-zipfile" target="id-dv-df-mft-to-edge-fl" archimateRelationship="id-rel-assoc-zip-flow4">
          <bendpoint startX="24" startY="45" endX="-338" endY="73"/>
          <bendpoint startX="312" startY="45" endX="-50" endY="73"/>
        </sourceConnection>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-dv-df-private-res" targetConnections="id-dv-df-privloc-to-res" textAlignment="1" archimateElement="id-other-grp-private-res">
        <bounds x="492" y="54" width="301" height="97"/>
        <child xsi:type="archimate:DiagramObject" id="id-dv-df-onprem-db" targetConnections="id-dv-df-edge-to-db" fillColor="#feffff" textPosition="1" archimateElement="id-app-svc-onprem-db">
          <bounds x="168" y="36" width="120" height="55"/>
          <sourceConnection xsi:type="archimate:Connection" id="id-dv-df-db-to-edge" source="id-dv-df-onprem-db" target="id-dv-df-edge-proc" archimateRelationship="id-rel-srv-db-edge"/>
        </child>
        <child xsi:type="archimate:DiagramObject" id="id-dv-df-edge-proc" targetConnections="id-dv-df-intg-to-edge id-dv-df-intg-to-edge-sv id-dv-df-db-to-edge id-dv-df-mft-to-edge-fl id-dv-df-mft-to-edge-sv" fillColor="#feffff" textPosition="1" archimateElement="id-app-svc-edge-proc">
          <bounds x="24" y="36" width="120" height="55"/>
          <sourceConnection xsi:type="archimate:Connection" id="id-dv-df-edge-to-db" source="id-dv-df-edge-proc" target="id-dv-df-onprem-db" archimateRelationship="id-rel-flow-edge-db">
