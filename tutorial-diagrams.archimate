    <element xsi:type="archimate:ApplicationService" name="On-Prem Database" id="id-app-svc-onprem-db"/>
  </folder>
  <folder name="Technology &amp; Physical" id="id-fldr-tech" type="technology"/>
  <folder name="Motivation" id="id-fldr-motvn" type="motivation"/>
  <folder name="Implementation &amp; Migration" id="id-fldr-impl-mig" type="implementation_migration"/>
  <folder name="Other" id="id-fldr-other" type="other">
    <element xsi:type="archimate:Grouping" name="IBM SaaS" id="id-other-grp-ibm-saas"/>
    <element xsi:type="archimate:Location" name="AWS / Azure Region" id="id-other-loc-cloud-rgn"/>
    <element xsi:type="archimate:Grouping" name="Private Resources (e.g. On-premise LAN)" id="id-other-grp-private-res"/>
    <element xsi:type="archimate:Location" name="Private Location" id="id-other-loc-private"/>
  </folder>
  <folder name="Relations" id="id-fldr-rels" type="relations">
    <element xsi:type="archimate:FlowRelationship" id="id-rel-flow-3pclient-mft" source="id-biz-actor-3p-client" target="id-app-svc-mft-saas"/>
    <element xsi:type="archimate:AssociationRelationship" id="id-rel-assoc-zip-flow1" source="id-biz-obj-zipfile" target="id-rel-flow-3pclient-mft"/>
    <element xsi:type="archimate:FlowRelationship" id="id-rel-flow-mft-intg" source="id-app-svc-mft-saas" target="id-app-svc-intg-saas"/>
