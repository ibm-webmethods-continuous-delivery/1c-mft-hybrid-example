    <element xsi:type="archimate:ServingRelationship" id="id-rel-srv-intg-mft" source="id-app-svc-intg-saas" target="id-app-svc-mft-saas"/>
    <element xsi:type="archimate:ServingRelationship" id="id-rel-srv-intg-edge" source="id-app-svc-intg-saas" target="id-app-svc-edge-proc"/>
    <element xsi:type="archimate:ServingRelationship" id="id-rel-srv-db-edge" source="id-app-svc-onprem-db" target="id-app-svc-edge-proc"/>
    <element xsi:type="archimate:FlowRelationship" id="id-rel-flow-edge-db" source="id-app-svc-edge-proc" target="id-app-svc-onprem-db"/>
    <element xsi:type="archimate:FlowRelationship" id="id-rel-flow-mft-edge" source="id-app-svc-mft-saas" target="id-app-svc-edge-proc"/>
